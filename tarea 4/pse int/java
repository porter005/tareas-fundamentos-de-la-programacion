package fundamentos_de_la_programacion;
import java.util.Scanner;
public class tarea4 {
	public static void main(String[] args) {
	        Scanner sc = new Scanner(System.in);

	        // 1.
	        System.out.println("1. H, S, R:");
	        int h = sc.nextInt(), s = sc.nextInt(), r = sc.nextInt();
	        System.out.println("Días: " + ((h - r - 1) / (s - r) + 1));

	        // 2. 
	        System.out.println("2. Monedas N y Piratas K:");
	        int n = sc.nextInt(), k = sc.nextInt();
	        int capitan = n - (k * (n / k));
	        System.out.println("Capitán: " + capitan);

	        // 3. 
	        System.out.println("3. Minutos:");
	        int t = sc.nextInt();
	        System.out.println("Hora: " + (t / 60 % 24) + ":" + (t % 60));

	        // 4.
	        System.out.println("4. Tornillos:");
	        int x = sc.nextInt();
	        System.out.println("Cajas: " + (x / 12) + " Sueltos: " + (x % 12));

	        // 5. 
	        System.out.println("5. Monto:");
	        int monto = sc.nextInt();
	        int entregado = (monto / 100) * 100;
	        System.out.println("Entregó: " + entregado + " Perdió: " + (monto - entregado));

	        // 6.
	        System.out.println("6. Número 2 cifras:");
	        int num = sc.nextInt();
	        System.out.println("Invertido: " + ((num % 10) * 10 + (num / 10)));

	        // 7.
	        System.out.println("7. Radio:");
	        int rad = sc.nextInt();
	        int area = (int)(3.14159 * rad * rad); 
	        System.out.println("Área: " + area);

	        // 8. 
	        System.out.println("8. Segundos:");
	        int segs = sc.nextInt();
	        System.out.printf("%dh %dm %ds\n", (segs / 3600), (segs % 3600 / 60), (segs % 60));

	        // 9. 
	        System.out.println("9. Minutos:");
	        int minP = sc.nextInt();
	        System.out.println("Horas a cobrar: " + (minP + 59) / 60);

	        // 10. 
	        int a = 5, b = 10;
	        a = a + b; b = a - b; a = a - b;
	        System.out.println("10. A:" + a + " B:" + b);

	        // 11.
	        System.out.println("11. PIN 4 dígitos:");
	        int pin = sc.nextInt();
	        System.out.println("Hash: " + (pin/1000 + pin/100%10 + pin/10%10 + pin%10));

	        // 12. 
	        System.out.println("12. N:");
	        int exp = sc.nextInt();
	        System.out.println("Hosts: " + ((int)Math.pow(2, exp) - 2));

	        // 13. 
	        System.out.println("13. ID:");
	        int id = sc.nextInt();
	        System.out.println("Servidor: " + (id % 3));

	        // 14. 
	        System.out.println("14. Secreto y Llave:");
	        int sec = sc.nextInt(), llave = sc.nextInt();
	        System.out.println("Cifrado: " + (sec + llave) % 10);

	        // 15.
	        System.out.println("15. D y V:");
	        int dist = sc.nextInt(), vel = sc.nextInt();
	        System.out.println("Segundos: " + (dist + vel - 1) / vel);

	    }
	}
