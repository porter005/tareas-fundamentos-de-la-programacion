Algoritmo tarea8_ejrc13
    Leer p
    Si p < 52 Entonces 
		Escribir "Mosca"
    Sino
        Si p <= 63 Entonces
			Escribir "Ligero"
        Sino
            Si p <= 75 Entonces 
				Escribir "Mediano"
            Sino
                Si p <= 91 Entonces 
					Escribir "Pesado"
                Sino 
					Escribir "Súper Pesado" 
				FinSi
            FinSi
        FinSi
    FinSi
FinAlgoritmo