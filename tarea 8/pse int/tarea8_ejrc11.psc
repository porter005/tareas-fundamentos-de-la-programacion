Algoritmo tarea8_ejrc11
    Leer a, b
    Si a = 6 Y b <= 4 Entonces
        Escribir "Gana A"
    Sino
        Si b = 6 Y a <= 4 Entonces
            Escribir "Gana B"
        Sino
            Si a >= 5 Y b >= 5 Entonces
                Escribir "Llegar a 7 o muerte súbita"
            Sino
                Escribir "En juego"
            FinSi
        FinSi
    FinSi
FinAlgoritmo