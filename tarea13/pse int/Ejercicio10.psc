Algoritmo Ejercicio10
    Leer a, b, c
    Si a>b Y b>c Entonces 
		Escribir a,b,c
		Si a>c Y c>b Entonces
			Escribir a,c,b
			Si b>a Y a>c Entonces 
				Escribir b,a,c
				Si b>c Y c>a Entonces 
					Escribir b,c,a
					Si c>a Y a>b Entonces 
						Escribir c,a,b
						Si c>b Y b>a Entonces 
							Escribir c,b,a
						FinSi
					FinSi
				FinSi
			FinSi
		FinSi
	FinSi
FinAlgoritmo