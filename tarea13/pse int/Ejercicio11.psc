Algoritmo Ejercicio11
    Leer num
    Si num < 10 Entonces 
		Escribir "1 cifra"
    Sino Si num < 100 Entonces 
			Escribir "2 cifras"
		Sino Si num < 1000 Entonces 
				Escribir "3 cifras"
			Sino Si num < 10000 Entonces 
					Escribir "4 cifras"
				Sino 
					Escribir "5 cifras"
				FinSi 
			FinSi 
		FinSi 
	FinSi
FinAlgoritmo