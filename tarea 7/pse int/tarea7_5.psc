Algoritmo tarea7_5
	Definir velocidad, tiempo, distancia Como Real
    Escribir "Introduce la velocidad del automovil (km/h):"
    Leer velocidad
    Escribir "Introduce el tiempo de viaje (horas):"
    Leer tiempo
    distancia <- velocidad * tiempo
    Escribir "La distancia recorrida es: ", distancia
FinAlgoritmo
